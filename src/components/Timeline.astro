---
interface Experience {
  role: string;
  company: string;
  dateRange: string;
  location?: string;
  description: string;
}

const experiences: Experience[] = [
  {
    role: "Principal Software Engineer",
    company: "Audax (Standard Chartered Ventures)",
    dateRange: "May 2025 – Present",
    location: "Bengaluru",
    description:
      "Led greenfield delivery of three core banking modules (Products, Payments & Cards, Accounts & Transactions) with a team of 15 engineers. Hands-on across architecture, service development, ISO 20022 integration, and CI/CD.",
  },
  {
    role: "Engineering Lead",
    company: "Standard Chartered Bank",
    dateRange: "Oct 2020 – May 2025",
    location: "Bengaluru",
    description:
      "Architected the CQRS-based Accounts & Transactions layer and led Open Banking (BISNAP) for Indonesia. Also built OPA-based API authorization, the Nexus Tracer logging framework, and a loan ops portal.",
  },
  {
    role: "Lead Consultant",
    company: "ThoughtWorks Technologies India",
    dateRange: "Dec 2019 – Oct 2020",
    location: "Bengaluru",
    description:
      "Security Champion following the STRIDE model on an existing pricing product. Handled upgrades and migrated from a long-running AWS EMR cluster to ephemeral clusters.",
  },
  {
    role: "Technical Architect",
    company: "Rupeelog Financial Services",
    dateRange: "Jan 2019 – Dec 2019",
    location: "Bengaluru",
    description:
      "Built a multi-tenant PWA and microservices for reporting, mandates and communication. Integrated with NSE and BSE for mutual fund transactions.",
  },
  {
    role: "Technical Architect",
    company: "TCS BaNCS Branch Banking",
    dateRange: "Jun 2014 – Dec 2018",
    description:
      "Architected the Branch Channel solution and a metadata-driven UI framework, led teams across implementations in Israel, Australia, Sweden, the Middle East and the UK. Mentored juniors along the way.",
  },
  {
    role: "Technical Lead",
    company: "TCS BaNCS Corporate Banking",
    dateRange: "May 2011 – Apr 2014",
    description:
      "Led the team building a metadata-based bulk payments file processing engine, including its performance tuning and security.",
  },
  {
    role: "Developer",
    company: "TCS BaNCS Wealth Management",
    dateRange: "Jan 2007 – Apr 2011",
    description:
      "Built reports and financial logic for cashflow, planning and portfolio rebalancing, and worked on site with the UK client to bridge their needs and the product.",
  },
];
---

<div class="relative my-6 border-s border-line-structure ml-2 sm:ml-3 pl-6 sm:pl-8 space-y-10">
  {experiences.map((exp) => (
    <div class="relative group">
      <div class="absolute -start-[29px] sm:-start-[37px] top-1.5 h-2 w-2 rounded-full bg-text-primary ring-4 ring-surface-bg transition-transform duration-200 group-hover:scale-125"></div>

      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h3 class="text-base sm:text-lg font-semibold text-text-primary">
          {exp.role}
          <span class="font-normal text-text-tertiary"> · </span>
          <span class="text-text-secondary font-medium">{exp.company}</span>
        </h3>
        <time class="text-xs font-mono text-text-tertiary sm:text-right shrink-0">
          {exp.dateRange}
        </time>
      </div>

      {exp.location && (
        <div class="mt-0.5 text-xs font-mono text-text-tertiary">
          {exp.location}
        </div>
      )}

      <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">
        {exp.description}
      </p>
    </div>
  ))}
</div>
