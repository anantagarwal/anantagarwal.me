---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li class="inline-block list-none">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1.5 rounded border border-line-structure bg-surface-1 hover:border-line-cta hover:bg-surface-2 font-mono text-text-secondary hover:text-text-primary transition-colors",
      size === "sm" ? "px-2.5 py-0.5 text-xs" : "px-3.5 py-1 text-sm font-medium",
    ]}
  >
    <span class="text-text-tertiary">#</span>
    <span>{tagName}</span>
  </a>
</li>
