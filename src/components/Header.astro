---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header class="sticky top-0 z-40 bg-surface-bg/95 backdrop-blur-md border-b border-line-structure">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 rounded border border-line-structure bg-surface-1 px-3 py-1.5 text-xs font-mono text-text-primary transition-all focus:top-3"
  >
    Skip to content
  </a>


  <!-- Primary Navbar -->
  <div
    id="nav-container"
    class="flex items-center justify-between px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3"
  >
    <!-- Brand / Wordmark -->
    <a
      href="/"
      class="group flex items-center gap-2 font-semibold text-base sm:text-lg text-text-primary tracking-tight transition-colors"
    >
      <span>Home</span>
    </a>

    <!-- Nav Links + Actions -->
    <nav id="nav-menu" class="flex items-center gap-2 sm:gap-4">
      <button
        id="menu-btn"
        class="p-1.5 rounded border border-line-structure text-text-secondary hover:text-text-primary hover:bg-surface-1 sm:hidden cursor-pointer"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden size-4" />
        <IconMenuDeep id="menu-icon" class="size-4" />
      </button>

      <ul
        id="menu-items"
        class:list={[
          "max-sm:absolute max-sm:top-full max-sm:inset-x-0 max-sm:bg-surface-bg max-sm:border-b max-sm:border-line-structure max-sm:p-4 max-sm:flex-col max-sm:gap-2",
          "hidden sm:flex sm:items-center sm:gap-1.5",
        ]}
      >
        <li>
          <a
            href="/posts"
            class:list={[
              "block px-3 py-1.5 text-xs font-mono font-medium rounded transition-colors text-text-tertiary hover:text-text-primary hover:bg-surface-1",
              { "active-nav !text-text-primary !bg-surface-2": isActive("/posts") },
            ]}
          >
            Posts
          </a>
        </li>
        <li>
          <a
            href="/tags"
            class:list={[
              "block px-3 py-1.5 text-xs font-mono font-medium rounded transition-colors text-text-tertiary hover:text-text-primary hover:bg-surface-1",
              { "active-nav !text-text-primary !bg-surface-2": isActive("/tags") },
            ]}
          >
            Tags
          </a>
        </li>
        <li>
          <a
            href="/about"
            class:list={[
              "block px-3 py-1.5 text-xs font-mono font-medium rounded transition-colors text-text-tertiary hover:text-text-primary hover:bg-surface-1",
              { "active-nav !text-text-primary !bg-surface-2": isActive("/about") },
            ]}
          >
            About
          </a>
        </li>
        {
          SITE.showArchives && (
            <li>
              <a
                href="/archives"
                class:list={[
                  "block px-3 py-1.5 text-xs font-mono font-medium rounded transition-colors text-text-tertiary hover:text-text-primary hover:bg-surface-1",
                  { "active-nav !text-text-primary !bg-surface-2": isActive("/archives") },
                ]}
                title="Archives"
              >
                Archives
              </a>
            </li>
          )
        }
      </ul>

      <!-- Action items: Search + Theme Toggle -->
      <div class="flex items-center gap-2 ms-1 sm:ms-2">
        <a
          href="/search"
          class:list={[
            "inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono text-text-tertiary hover:text-text-primary rounded border border-line-structure bg-surface-1 hover:border-line-cta hover:bg-surface-2 transition-colors",
            { "border-line-cta text-text-primary bg-surface-2": isActive("/search") },
          ]}
          aria-label="Search"
          title="Search"
        >
          <IconSearch class="size-3.5" />
          <span class="hidden sm:inline">Search</span>
          <kbd class="hidden md:inline-flex text-[10px] px-1 rounded bg-surface-bg border border-line-structure">⌘K</kbd>
        </a>

        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="relative size-7 flex items-center justify-center rounded border border-line-structure bg-surface-1 hover:border-line-cta hover:bg-surface-2 text-text-secondary hover:text-text-primary transition-colors cursor-pointer"
              title="Toggle theme"
              aria-label="Toggle theme"
            >
              <IconMoon class="size-3.5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute size-3.5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
