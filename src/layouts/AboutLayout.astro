---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex-1">
    <div class="mb-6 flex flex-col gap-1 border-b border-line-structure pb-6">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text-primary">
        {frontmatter.title}
      </h1>
      {frontmatter.description && (
        <p class="text-sm text-text-secondary leading-relaxed mt-1">
          {frontmatter.description}
        </p>
      )}
    </div>
    <slot />
  </main>
  <Footer />
</Layout>
