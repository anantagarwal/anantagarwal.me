---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="flex flex-1 items-center justify-center px-4 py-16"
  >
    <div class="flex flex-col items-center justify-center text-center max-w-md">
      <span class="font-mono text-xs uppercase tracking-wider text-text-tertiary mb-2">Error 404</span>
      <h1 class="text-6xl sm:text-7xl font-semibold tracking-tight text-text-primary">404</h1>
      <p class="mt-4 text-lg font-medium text-text-secondary">Page Not Found</p>
      <p class="mt-2 text-sm text-text-tertiary leading-relaxed">
        The page you are looking for doesn't exist or has been relocated.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center gap-1.5 px-4 py-2 rounded border border-line-structure bg-surface-1 hover:border-line-cta hover:bg-surface-2 text-xs font-mono text-text-primary transition-colors"
      >
        <span>&larr; Go back home</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
